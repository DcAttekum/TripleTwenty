<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="horizontal"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/timerwidget_background">

	<FrameLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1">
		<ImageButton
			android:id="@+id/widgetOpen"
			android:contentDescription="@android:string/copy"
			android:src="@drawable/ic_open"
			android:background="@drawable/timerwidget_button_selector"
			android:scaleType="centerInside"
			android:layout_gravity="center"
			android:layout_width="60dp"
			android:layout_height="60dp" />
	</FrameLayout>

	<FrameLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1">
		<ImageButton
			android:id="@+id/widgetPause"
			android:contentDescription="@android:string/copy"
			android:src="@drawable/ic_pause"
			android:background="@drawable/timerwidget_button_selector"
			android:scaleType="centerInside"
			android:layout_gravity="center"
			android:layout_width="60dp"
			android:layout_height="60dp" />
	</FrameLayout>

	<FrameLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1">
		<ImageButton
			android:id="@+id/widgetStart"
			android:contentDescription="@android:string/copy"
			android:src="@drawable/ic_start"
			android:background="@drawable/timerwidget_button_selector"
			android:scaleType="centerInside"
			android:layout_gravity="center"
			android:layout_width="60dp"
			android:layout_height="60dp" />
	</FrameLayout>

	<FrameLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1">
		<ImageButton
			android:id="@+id/widgetStop"
			android:contentDescription="@android:string/copy"
			android:src="@drawable/ic_stop"
			android:background="@drawable/timerwidget_button_selector"
			android:scaleType="centerInside"
			android:layout_gravity="center"
			android:layout_width="60dp"
			android:layout_height="60dp" />
	</FrameLayout>
</LinearLayout>