<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TripleTwenty.ViewModels"
             x:Class="TripleTwenty.Views.MainPage"
             x:DataType="viewmodels:MainViewModel">

    <Grid RowDefinitions="*, 100, 100, 100">
        <Label Grid.Row="0"
               HorizontalOptions="Center"
               Text="{Binding Time}"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="Purple" />

        <Button Grid.Row="1"
                Text="Start"
                FontSize="20"
                FontAttributes="Bold"
                Background="DarkGreen"
                Command="{Binding StartTimerCommand}" />

        <Button Grid.Row="2"
                Text="Pause"
                FontSize="20"
                FontAttributes="Bold"
                Background="Orange"
                Command="{Binding PauseTimerCommand}" />

        <Button Grid.Row="3"
                Text="Stop"
                FontSize="20"
                FontAttributes="Bold"
                Background="DarkRed"
                Command="{Binding StopTimerCommand}" />
    </Grid>

</ContentPage>
